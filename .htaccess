RewriteEngine On

# Deny internal code, cache, history and backups before the public front controllers.
# Applies both at the origin root and in an installation subdirectory.
RewriteRule ^(?:classes|vendor|tests|migrations|docs|var|bin)(?:/|$) - [F,END,NC]
RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,END,NC]
RewriteRule ^admin/views(?:/|$) - [F,END,NC]

# Configuration, SQL dumps and editor backups must never be served as static text.
<FilesMatch "(?i)(?:^config\.php(?:\..*)?$|^composer\.(?:json|lock)$|^\.|~$|\.(?:sql|log|ini|env|lock|bak|backup|old|orig|save|swp|sqlite|db|wallet|hex)$)">
    Require all denied
</FilesMatch>

# Apache may consume the Authorization header before PHP populates $_SERVER.
# Preserve it for API Bearer authentication (PHP may expose the value as
# HTTP_AUTHORIZATION or REDIRECT_HTTP_AUTHORIZATION after an internal rewrite).
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Greenfield API namespace goes to the dedicated exact API controller.
RewriteRule ^api/v1(?:/.*)?$ api.php [QSA,L]

# Ignoruj existující soubory (obrázky, CSS, JS) - ty ať se normálně načtou
RewriteCond %{REQUEST_FILENAME} !-f

# Všechno ostatní (včetně existujících složek jako /admin/) pošli do index.php
RewriteRule ^(.*)$ index.php [QSA,L]
