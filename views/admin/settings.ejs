<%- include('layout/header', { pageTitle: 'Settings - BTCPay Server Lite', activeMenu: 'settings', currentContextLabel: 'Settings' }) %>

<section class="page-header">
  <div class="page-header-copy">
    <p class="page-eyebrow">Instance Configuration</p>
    <h1>System Settings</h1>
    <p>Central operational policies for this BTCPay Server Lite instance.</p>
  </div>
</section>

<% if (pageError) { %>
  <div class="alert alert-error" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><%= pageError %></span>
  </div>
<% } %>

<% if (toastMsg) { %>
  <div class="alert alert-success" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    <span><%= toastMsg %></span>
  </div>
<% } %>

<section class="card">
  <div class="card-title">
    <span class="card-title-group"><i class="fa-solid fa-user-plus" aria-hidden="true"></i> Public Registrations</span>
    <span class="badge <%= registrationEnabled ? 'badge-Settled' : 'badge-Expired' %>">
      <%= registrationEnabled ? 'Enabled' : 'Disabled' %>
    </span>
  </div>
  <p class="card-subtitle">When disabled, existing accounts remain functional, but new merchants cannot register self-service stores or derivation accounts.</p>

  <form method="post" action="/admin/settings" class="form-stack">
    <input type="hidden" name="action" value="set_registration">
    <div class="field">
      <label for="registrationEnabled">Registration Access</label>
      <div class="input-wrap">
        <select id="registrationEnabled" name="registration_enabled">
          <option value="1" <%= registrationEnabled ? 'selected' : '' %>>Allow new user registrations</option>
          <option value="0" <%= !registrationEnabled ? 'selected' : '' %>>Disable new user registrations</option>
        </select>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="primary">
        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save Settings
      </button>
    </div>
  </form>
</section>

<%- include('layout/footer') %>
