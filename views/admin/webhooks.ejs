<%- include('layout/header', { pageTitle: 'Webhooks - BTCPay Server Lite', activeMenu: 'webhooks', currentContextLabel: 'Webhooks' }) %>

<section class="page-header">
  <div class="page-header-copy">
    <p class="page-eyebrow">Notifications</p>
    <h1>Webhooks</h1>
    <p>Manage cryptographically signed notification endpoints for invoice state changes.</p>
  </div>
</section>

<% if (pageError) { %>
  <div class="alert alert-error" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><%= pageError %></span>
  </div>
<% } %>

<% if (toastMsg) { %>
  <div class="alert alert-success" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    <span><%= toastMsg %></span>
  </div>
<% } %>

<div class="management-grid">
  <section class="card">
    <div class="card-title">
      <span class="card-title-group"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add Webhook</span>
    </div>
    <p class="card-subtitle">Endpoint will receive JSON notifications signed with an HMAC-SHA256 signature.</p>

    <form method="post" action="/admin/webhooks" class="form-stack">
      <input type="hidden" name="action" value="create_webhook">
      <div class="field">
        <label for="webhookStore">Store</label>
        <div class="input-wrap">
          <select id="webhookStore" name="store_id" required>
            <% stores.forEach(store => { %>
              <option value="<%= store.id %>"><%= store.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="webhookUrl">Webhook URL</label>
        <div class="input-wrap">
          <input id="webhookUrl" type="url" name="url" placeholder="https://eshop.example.com/api/btcpay-webhook" required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="primary">
          <i class="fa-solid fa-plus"></i> Save Webhook
        </button>
      </div>
    </form>
  </section>

  <section class="card security-card">
    <div class="card-title">
      <span class="card-title-group"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Secure Delivery</span>
    </div>
    <p class="card-subtitle">Webhook secret verifies HMAC signature via the <code>BTCPAY-SIG: sha256=...</code> header.</p>
    <div class="alert alert-warning">
      <i class="fa-solid fa-lock" aria-hidden="true"></i>
      <span>On each invoice event (New, Processing, Settled, Expired), a signed JSON payload is dispatched to registered URLs.</span>
    </div>
  </section>
</div>

<section class="card" style="margin-top: 2rem;">
  <div class="card-title">
    <span class="card-title-group"><i class="fa-solid fa-wave-square" aria-hidden="true"></i> Active Webhooks</span>
    <span class="badge s-unknown"><%= webhooks.length %></span>
  </div>

  <% if (webhooks.length === 0) { %>
    <div class="empty-state"><p>No active webhooks configured.</p></div>
  <% } else { %>
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Store</th>
            <th>Target URL</th>
            <th>Status</th>
            <th>Last Delivery</th>
            <th>Delivery Stats</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% webhooks.forEach(wh => { %>
            <tr>
              <td><strong><%= wh.store_name || wh.store_id %></strong></td>
              <td><code><%= wh.url %></code></td>
              <td><span class="badge badge-Settled"><%= wh.status %></span></td>
              <td class="muted"><%= wh.last_delivery ? new Date(wh.last_delivery * 1000).toLocaleString('en-US') : 'Never' %></td>
              <td><%= wh.success_count %>x OK, <%= wh.fail_count %>x Failed</td>
              <td>
                <form method="post" action="/admin/webhooks" style="display: inline;">
                  <input type="hidden" name="action" value="test_webhook">
                  <input type="hidden" name="webhook_id" value="<%= wh.id %>">
                  <button type="submit" class="ghost-btn" style="font-size: 0.85rem;">
                    <i class="fa-solid fa-paper-plane"></i> Test Ping
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('layout/footer') %>
