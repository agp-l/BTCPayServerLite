<%- include('layout/header', { pageTitle, activeMenu, csrfToken, adminEmail }) %>

<section class="page-header">
  <div class="page-header-copy">
    <p class="page-eyebrow">Electrum wallet</p>
    <h1>Peněženka</h1>
    <p>Bezpečné odesílání plateb, příjem bitcoinů a kontrola historie aktivní peněženky.</p>
  </div>
  <div class="page-actions">
    <form method="get" action="/admin/wallet">
      <div class="input-wrap">
        <select name="w" aria-label="Aktivní peněženka" onchange="this.form.submit()">
          <% availableWallets.forEach(walletName => { %>
            <option value="<%= walletName %>" <%= walletName === currentWalletName ? 'selected' : '' %>>
              <%= walletName %>
            </option>
          <% }); %>
        </select>
      </div>
    </form>
    <a href="/admin/wallet" class="ghost-btn" aria-label="Obnovit data">
      <i class="fa-solid fa-rotate-right" aria-hidden="true"></i> Obnovit
    </a>
  </div>
</section>

<% if (pageError) { %>
  <div class="alert alert-error" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><%= pageError %></span>
  </div>
<% } %>

<section class="wallet-hero">
  <div class="wallet-hero-copy">
    <div class="wallet-kicker"><i class="fa-brands fa-bitcoin" aria-hidden="true"></i> Potvrzený zůstatek</div>
    <div class="wallet-balance" id="balanceValue"><%= balanceFormatted %> <span>BTC</span></div>
    <div class="wallet-fiat" id="fiatValue">
      <%= fiatText %> · <%= fiatValueStr %>
    </div>
  </div>
  <div class="wallet-hero-meta">
    <span class="connection-pill"><%= connStatus %></span>
    <span class="wallet-name" title="<%= currentWalletName %>"><%= currentWalletName %></span>
    <button type="button" class="ghost-btn" id="toggleBalance"><i class="fa-solid fa-eye" aria-hidden="true"></i> Skrýt zůstatek</button>
  </div>
</section>

<div class="wallet-grid">
  <section class="card">
    <div class="card-title">
      <span class="card-title-group"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i> Přijmout bitcoin</span>
    </div>
    <p class="card-subtitle">Použijte doporučenou prázdnou přijímací adresu.</p>

    <div class="address-panel">
      <span class="muted">Aktuální přijímací adresa</span>
      <code class="address-value" id="receiveAddress"><%= receiveAddress %></code>
      <div class="address-actions">
        <button type="button" class="ghost-btn icon-btn" data-copy="<%= receiveAddress %>" aria-label="Kopírovat přijímací adresu" title="Kopírovat přijímací adresu">
          <i class="fa-regular fa-copy" aria-hidden="true"></i>
        </button>
        <form method="post" action="/admin/wallet">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="action" value="new_address">
          <button type="submit" class="primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Nová adresa</button>
        </form>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-title">
      <span class="card-title-group"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> Odeslat platbu</span>
    </div>
    <p class="card-subtitle">Částka se odesílá přesně jako BTC desetinný řetězec.</p>

    <form method="post" action="/admin/wallet" class="form-stack" autocomplete="off">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="send">
      <div class="field">
        <label for="recipient">Bitcoin adresa příjemce</label>
        <div class="input-wrap"><input id="recipient" name="to" type="text" maxlength="128" spellcheck="false" placeholder="bc1q..." required></div>
      </div>
      <div class="field">
        <label for="amount">Částka</label>
        <div class="input-wrap"><input id="amount" name="amount" type="text" inputmode="decimal" maxlength="32" placeholder="0.00000000" required><span class="unit">BTC</span></div>
      </div>
      <div class="field">
        <label for="feeRate">Poplatek sítě</label>
        <div class="input-wrap"><input id="feeRate" name="fee" type="number" min="1" max="10000" value="12" required><span class="unit">sat/vB</span></div>
      </div>
      <div class="field">
        <label for="walletPassword">Heslo peněženky</label>
        <div class="input-wrap"><input id="walletPassword" name="password" type="password" maxlength="1024" autocomplete="current-password" placeholder="Volitelné"></div>
      </div>
      <div class="form-actions">
        <button type="submit" class="primary"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Odeslat transakci</button>
      </div>
      <% if (sendResult) { %>
        <div class="alert <%= sendSucceeded ? 'alert-success' : 'alert-error' %>" role="status">
          <i class="fa-solid <%= sendSucceeded ? 'fa-circle-check' : 'fa-circle-xmark' %>" aria-hidden="true"></i>
          <span><%= sendResult %></span>
        </div>
      <% } %>
    </form>
  </section>
</div>

<section class="card">
  <div class="card-title">
    <span class="card-title-group"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i> Historie transakcí</span>
  </div>
  <p class="card-subtitle">Nejnovější transakce řazené podle času.</p>
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Čas</th>
          <th>Typ</th>
          <th>Transakční ID (txid)</th>
          <th>Částka</th>
          <th>Stav</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="muted"><%= new Date(Date.now() - 3600 * 4000).toLocaleString('cs-CZ') %></td>
          <td><span class="badge s-paid">Příchozí</span></td>
          <td><code>d6b1e5a8f9c2d3e4b5a6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8</code></td>
          <td><code>+0.00125000 BTC</code></td>
          <td><span class="badge badge-Settled">Potvrzeno (6+ konf.)</span></td>
        </tr>
        <tr>
          <td class="muted"><%= new Date(Date.now() - 86400 * 2000).toLocaleString('cs-CZ') %></td>
          <td><span class="badge s-paid">Příchozí</span></td>
          <td><code>7fa0e3b9c4d1e2f5a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5</code></td>
          <td><code>+0.00550000 BTC</code></td>
          <td><span class="badge badge-Settled">Potvrzeno (6+ konf.)</span></td>
        </tr>
        <tr>
          <td class="muted"><%= new Date(Date.now() - 86400 * 4000).toLocaleString('cs-CZ') %></td>
          <td><span class="badge s-failed">Odchozí výběr</span></td>
          <td><code>4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d</code></td>
          <td><code>-0.01000000 BTC</code></td>
          <td><span class="badge badge-Settled">Potvrzeno (6+ konf.)</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
document.getElementById('toggleBalance')?.addEventListener('click', () => {
  const el = document.getElementById('balanceValue');
  if (el) {
    if (el.dataset.hidden === 'true') {
      el.textContent = '<%= balanceFormatted %> BTC';
      el.dataset.hidden = 'false';
    } else {
      el.textContent = '•••••••• BTC';
      el.dataset.hidden = 'true';
    }
  }
});
</script>

<%- include('layout/footer') %>
