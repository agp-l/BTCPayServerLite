<%- include('layout/header', { pageTitle: 'Invoices - BTCPay Server Lite', activeMenu: 'invoices', currentContextLabel: 'Invoices' }) %>

<section class="page-header">
  <div class="page-header-copy">
    <p class="page-eyebrow">Database Checkout</p>
    <h1>Invoices</h1>
    <p>Issue precise Bitcoin invoices and manage customer checkout links seamlessly.</p>
  </div>
  <div class="page-actions">
    <a href="/admin/url_invoices" class="ghost-btn">
      <i class="fa-solid fa-link" aria-hidden="true"></i> Stateless URL Invoices
    </a>
  </div>
</section>

<% if (pageError) { %>
  <div class="alert alert-error" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><%= pageError %></span>
  </div>
<% } %>

<% if (toastMsg) { %>
  <div class="alert alert-success" role="status">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    <span><%= toastMsg %></span>
  </div>
<% } %>

<div class="management-grid" style="margin-bottom: 2rem;">
  <section class="card">
    <div class="card-title">
      <span class="card-title-group"><i class="fa-solid fa-file-circle-plus"></i> Issue New Invoice</span>
    </div>
    <p class="card-subtitle">Invoice automatically derives a unique Bitcoin address and generates a checkout link.</p>

    <form method="post" action="/admin/invoices" class="form-stack">
      <input type="hidden" name="action" value="create_invoice">
      <div class="field">
        <label for="invoiceStore">Store</label>
        <div class="input-wrap">
          <select id="invoiceStore" name="store_id" required>
            <% stores.forEach(store => { %>
              <option value="<%= store.id %>"><%= store.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="invoiceTitle">Order Description / Title</label>
        <div class="input-wrap">
          <input id="invoiceTitle" type="text" name="title" placeholder="e.g. Order #10941" required>
        </div>
      </div>
      <div class="field">
        <label for="invoiceAmount">Amount in BTC</label>
        <div class="input-wrap">
          <input id="invoiceAmount" type="text" name="amount" placeholder="0.00050000" pattern="[0-9]*\.?[0-9]+" required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="primary">
          <i class="fa-solid fa-plus"></i> Create Invoice
        </button>
      </div>
    </form>
  </section>

  <section class="card filter-card">
    <div class="card-title">
      <span class="card-title-group"><i class="fa-solid fa-filter"></i> Filter Invoices</span>
    </div>
    <form method="get" action="/admin/invoices" class="filter-bar filter-bar-wide" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
      <div class="field">
        <label for="invoiceStoreFilter">Store</label>
        <div class="input-wrap">
          <select id="invoiceStoreFilter" name="store_id">
            <option value="">All stores</option>
            <% stores.forEach(store => { %>
              <option value="<%= store.id %>" <%= selectedStoreId === store.id ? 'selected' : '' %>><%= store.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="invoiceStatusFilter">Status</label>
        <div class="input-wrap">
          <select id="invoiceStatusFilter" name="status">
            <option value="">All statuses</option>
            <option value="New" <%= selectedStatus === 'New' ? 'selected' : '' %>>New</option>
            <option value="Processing" <%= selectedStatus === 'Processing' ? 'selected' : '' %>>Processing</option>
            <option value="Settled" <%= selectedStatus === 'Settled' ? 'selected' : '' %>>Settled</option>
            <option value="Expired" <%= selectedStatus === 'Expired' ? 'selected' : '' %>>Expired</option>
          </select>
        </div>
      </div>
      <div class="filter-actions" style="margin-top: 0.5rem;">
        <button type="submit" class="primary"><i class="fa-solid fa-filter"></i> Filter</button>
        <a class="ghost-btn" href="/admin/invoices">Reset</a>
      </div>
    </form>
  </section>
</div>

<section class="card">
  <div class="card-title">
    <span class="card-title-group"><i class="fa-solid fa-database"></i> Database Invoices</span>
    <span class="badge s-unknown"><%= filteredInvoices.length %></span>
  </div>
  <p class="card-subtitle">Showing latest invoices matching current filter.</p>

  <% if (filteredInvoices.length === 0) { %>
    <div class="empty-state"><p>No invoices match the filter criteria.</p></div>
  <% } else { %>
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Store / Client</th>
            <th>Invoice</th>
            <th>Address & Source</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Expires</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% filteredInvoices.forEach(invoice => { %>
            <tr>
              <td class="muted"><%= new Date(invoice.created_at * 1000).toLocaleString('en-US') %></td>
              <td>
                <strong><%= invoice.store_name %></strong><br>
                <span class="muted" style="font-size: 0.8rem;"><%= invoice.client_email %></span>
              </td>
              <td>
                <code><%= invoice.id %></code>
                <% if (invoice.idempotency_key) { %>
                  <div style="font-size: 0.7rem; color: var(--muted);"><i class="fa-solid fa-fingerprint"></i> Idempotent</div>
                <% } %>
              </td>
              <td>
                <div style="font-family: monospace; font-size: 0.8rem;"><%= invoice.address.substring(0, 10) %>...<%= invoice.address.substring(invoice.address.length - 6) %></div>
                <div style="margin-top: 2px;">
                  <% if (invoice.address_source === 'xpub') { %>
                    <span class="badge badge-Settled" style="font-size: 0.7rem; padding: 2px 6px;">XPUB #<%= invoice.derivation_index !== null && invoice.derivation_index !== undefined ? invoice.derivation_index : '0' %></span>
                  <% } else { %>
                    <span class="badge s-unknown" style="font-size: 0.7rem; padding: 2px 6px;">Electrum RPC</span>
                  <% } %>
                </div>
              </td>
              <td><code><%= invoice.amount %> BTC</code></td>
              <td><span class="badge badge-<%= invoice.status %>"><%= invoice.status %></span></td>
              <td class="muted"><%= new Date(invoice.expires_at * 1000).toLocaleString('en-US') %></td>
              <td>
                <div class="table-actions" style="display: flex; gap: 0.5rem; align-items: center;">
                  <a class="ghost-btn" target="_blank" rel="noopener" href="/pay?id=<%= invoice.id %>" title="Open checkout">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                  <form method="post" action="/admin/invoices" class="inline-edit-form" style="display: inline-flex; gap: 0.25rem;">
                    <input type="hidden" name="action" value="change_status">
                    <input type="hidden" name="invoice_id" value="<%= invoice.id %>">
                    <select name="status" aria-label="New invoice status" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; border-radius: 6px; border: 1px solid var(--line);">
                      <option value="New" <%= invoice.status === 'New' ? 'selected' : '' %>>New</option>
                      <option value="Processing" <%= invoice.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                      <option value="Settled" <%= invoice.status === 'Settled' ? 'selected' : '' %>>Settled</option>
                      <option value="Expired" <%= invoice.status === 'Expired' ? 'selected' : '' %>>Expired</option>
                    </select>
                    <button class="ghost-btn" type="submit" aria-label="Save status" title="Save status">
                      <i class="fa-solid fa-floppy-disk"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('layout/footer') %>
