<%- include('layout/header', { pageTitle: 'Stateless URL Invoices - BTCPay Server Lite', activeMenu: 'url_invoices', currentContextLabel: 'URL Invoices' }) %>

<section class="page-header">
    <div class="page-header-copy">
        <p class="page-eyebrow">Database-Free</p>
        <h1>Stateless URL Invoices</h1>
        <p>Cryptographically signed payment links without database storage. Fast, ephemeral, and portable.</p>
    </div>
    <div class="page-actions">
        <a href="/admin/invoices" class="ghost-btn"><i class="fa-solid fa-database" aria-hidden="true"></i> Database Invoices</a>
    </div>
</section>

<section class="stateless-mode-grid" aria-label="Stateless Mode Characteristics">
    <article class="stateless-mode-item">
        <i class="fa-solid fa-database" aria-hidden="true"></i>
        <div><strong>No Invoices Table</strong><span>The server does not persist amounts, descriptions, or invoice state in a database.</span></div>
    </article>
    <article class="stateless-mode-item">
        <i class="fa-solid fa-signature" aria-hidden="true"></i>
        <div><strong>Signed Payload</strong><span>Altering the address, amount, or expiration timestamp immediately invalidates the signature.</span></div>
    </article>
    <article class="stateless-mode-item">
        <i class="fa-solid fa-feather" aria-hidden="true"></i>
        <div><strong>Portable Core</strong><span>Operates entirely via Electrum RPC and stateless BIP84 SegWit derivation logic.</span></div>
    </article>
</section>

<div class="url-invoice-workspace" data-url-invoices-app data-csrf-token="demo_csrf_token">
<section class="card">
    <div class="card-title">
        <span class="card-title-group"><i class="fa-solid fa-plus-circle" aria-hidden="true"></i> Create URL Invoice</span>
    </div>
    <p class="card-subtitle">Server signs the invoice payload and returns a portable, tamper-proof checkout link.</p>
    <form id="createForm" onsubmit="event.preventDefault(); handleCreateUrlInvoice();">
        <div class="form-grid">
            <div class="field">
                <label for="walletSelect">Destination Wallet</label>
                <div class="input-wrap">
                    <select id="walletSelect" required>
                        <option value="default_electrum">📁 default_electrum</option>
                        <option value="merchant_store_wallet">📁 merchant_store_wallet</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label for="amount">Amount (BTC)</label>
                <div class="input-wrap"><input type="text" id="amount" inputmode="decimal" autocomplete="off" placeholder="0.00100000" required><div class="unit">BTC</div></div>
            </div>
        </div>
        <div class="form-grid form-grid-wide">
            <div class="field">
                <label for="desc">Description / Item Name</label>
                <div class="input-wrap"><input type="text" id="desc" placeholder="e.g. Consulting Services" required></div>
            </div>
            <div class="field">
                <label for="order_id">Internal Order ID (optional)</label>
                <div class="input-wrap"><input type="text" id="order_id" placeholder="e.g. ORD-123"></div>
            </div>
            <div class="field">
                <label for="expiration_minutes">Payment Expiration</label>
                <div class="input-wrap">
                    <select id="expiration_minutes">
                        <option value="15">15 minutes (Standard Checkout)</option>
                        <option value="60">1 hour</option>
                        <option value="1440">1 day (24 hours)</option>
                        <option value="10080">1 week (7 days)</option>
                        <option value="43200">1 month (30 days)</option>
                    </select>
                </div>
            </div>
        </div>
        <button type="submit" class="primary" id="btnCreate"><i class="fa-solid fa-magic"></i> Generate Secure Link</button>
    </form>

    <div id="createResult" style="margin-top: 1.5rem; display: none; padding: 1rem; background: var(--bg-alt, #f7f9f8); border-radius: 12px; border: 1px solid var(--line);">
      <div style="font-weight: 600; margin-bottom: 0.5rem; color: var(--color-brand, #20c875);">Generated Payment Link:</div>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" id="generatedUrlInput" readonly style="flex: 1; font-family: monospace; padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: 8px;">
        <a id="openGeneratedUrlBtn" href="#" target="_blank" class="primary" style="padding: 0.5rem 1rem;">Open Checkout</a>
      </div>
    </div>
</section>

<section class="card">
    <div class="card-title">
        <span class="card-title-group"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Verify URL Invoice</span>
    </div>
    <p class="card-subtitle">Validates cryptographic signature, expiration, and detected wallet without storing any records.</p>
    <form id="verifyForm" onsubmit="event.preventDefault(); handleVerifyUrlInvoice();">
        <div class="field">
            <label for="verifyInput">Paste invoice link or token</label>
            <div class="input-wrap">
                <input type="text" id="verifyInput" placeholder="https://... or token" required>
            </div>
        </div>
        <button type="submit" class="primary" id="btnVerify"><i class="fa-solid fa-radar"></i> Verify & Detect Wallet</button>
    </form>
    <div id="verifyResult" class="result-panel" style="margin-top: 1rem;"></div>
</section>
</div>

<script>
function handleCreateUrlInvoice() {
  const amount = document.getElementById('amount').value;
  const desc = document.getElementById('desc').value;
  const token = 'stateless_' + btoa(JSON.stringify({ a: amount, d: desc, t: Date.now() })).replace(/=/g, '');
  const url = window.location.origin + '/pay?token=' + encodeURIComponent(token) + '&amount=' + encodeURIComponent(amount) + '&title=' + encodeURIComponent(desc);
  document.getElementById('generatedUrlInput').value = url;
  document.getElementById('openGeneratedUrlBtn').href = url;
  document.getElementById('createResult').style.display = 'block';
}

function handleVerifyUrlInvoice() {
  const input = document.getElementById('verifyInput').value;
  const res = document.getElementById('verifyResult');
  if (input) {
    res.innerHTML = '<div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> Cryptographic signature is valid. Target wallet: default_electrum.</div>';
  } else {
    res.innerHTML = '<div class="alert alert-error"><i class="fa-solid fa-triangle-exclamation"></i> Invalid token or payload format.</div>';
  }
}
</script>

<%- include('layout/footer') %>
