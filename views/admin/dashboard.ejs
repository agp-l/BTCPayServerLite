<%- include('layout/header', { pageTitle: 'Dashboard - BTCPay Server Lite', activeMenu: 'dashboard', currentContextLabel: 'Dashboard' }) %>

<section class="page-header">
  <div class="page-header-copy">
    <p class="page-eyebrow">Operational Overview</p>
    <h1>Dashboard</h1>
    <p>Real-time status of stores, invoices, and processed Bitcoin volume in one unified place.</p>
  </div>
  <div class="page-actions">
    <a href="/admin/wallet" class="ghost-btn">
      <i class="fa-solid fa-wallet" aria-hidden="true"></i> Open Wallet
    </a>
    <a href="/admin/invoices" class="primary">
      <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i> Create Invoice
    </a>
  </div>
</section>

<% if (pageError) { %>
  <div class="alert alert-error" role="alert">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><%= pageError %></span>
  </div>
<% } %>

<section class="stats-grid" aria-label="Summary Statistics">
  <article class="stat-card">
    <div class="stat-card-head"><span class="stat-icon"><i class="fa-solid fa-store" aria-hidden="true"></i></span></div>
    <div class="stat-label">Active Stores</div>
    <div class="stat-value"><%= stores.length %></div>
    <div class="stat-meta">Connected projects and e-commerce stores</div>
  </article>

  <article class="stat-card stat-card-blue">
    <div class="stat-card-head"><span class="stat-icon"><i class="fa-solid fa-file-invoice" aria-hidden="true"></i></span></div>
    <div class="stat-label">Total Invoices</div>
    <div class="stat-value"><%= invoices.length %></div>
    <div class="stat-meta">Total count of invoices generated</div>
  </article>

  <article class="stat-card">
    <div class="stat-card-head">
      <span class="stat-icon"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
      <span class="badge badge-Settled"><%= settlementRate %> %</span>
    </div>
    <div class="stat-label">Settled Invoices</div>
    <div class="stat-value"><%= settledCount %></div>
    <div class="stat-meta">Share of successfully settled payments</div>
  </article>

  <article class="stat-card stat-card-amber">
    <div class="stat-card-head"><span class="stat-icon"><i class="fa-brands fa-bitcoin" aria-hidden="true"></i></span></div>
    <div class="stat-label">Processed Volume</div>
    <div class="stat-value code"><%= totalBtcVolume %> BTC</div>
    <div class="stat-meta">Confirmed on-chain invoices only</div>
  </article>
</section>

<div class="dashboard-grid">
  <section class="card">
    <div class="card-title">
      <span class="card-title-group">
        <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
        Recent Invoices
      </span>
      <a href="/admin/invoices" class="action-link">View All</a>
    </div>
    <p class="card-subtitle">Overview of recent Bitcoin transactions and issued checkout invoices.</p>

    <% if (invoices.length === 0) { %>
      <div class="empty-state"><p>No invoices created yet.</p></div>
    <% } else { %>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Store</th>
              <th>Amount</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% invoices.slice(0, 5).forEach(inv => { %>
              <tr>
                <td class="muted"><%= new Date(inv.created_at * 1000).toLocaleString('en-US') %></td>
                <td><strong><%= inv.store_name %></strong><div class="muted"><%= inv.title %></div></td>
                <td><code><%= inv.amount %> BTC</code></td>
                <td><span class="badge badge-<%= inv.status %>"><%= inv.status %></span></td>
                <td>
                  <a href="/pay?id=<%= inv.id %>" target="_blank" class="ghost-btn" title="Open Checkout">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Checkout
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="card">
    <div class="card-title">
      <span class="card-title-group">
        <i class="fa-solid fa-wallet" aria-hidden="true"></i>
        Electrum Wallet Status
      </span>
      <a href="/admin/wallet" class="action-link">Manage</a>
    </div>
    <p class="card-subtitle">On-chain Bitcoin balance and connection to Electrum daemon.</p>

    <div class="wallet-stat-box" style="margin-bottom: 1.5rem; padding: 1.25rem; background: var(--bg-alt, #f7f9f8); border-radius: 12px;">
      <div class="stat-label">Total Confirmed Balance</div>
      <div style="font-size: 1.75rem; font-weight: 700; font-family: 'Fira Code', monospace; color: var(--color-brand, #20c875);">
        <%= walletBalance.confirmed %> BTC
      </div>
      <div class="stat-meta" style="margin-top: 0.25rem;">
        ≈ $<%= (parseFloat(walletBalance.confirmed) * 65000).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> USD (est. $65,000 / BTC)
      </div>
      <% if (parseFloat(walletBalance.unconfirmed) > 0) { %>
        <div style="margin-top: 0.5rem; font-size: 0.85rem; color: #e6a23c;">
          <i class="fa-solid fa-hourglass-half"></i> Unconfirmed: <%= walletBalance.unconfirmed %> BTC
        </div>
      <% } %>
    </div>

    <div class="card-title">
      <span class="card-title-group">
        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
        Quick Actions
      </span>
    </div>
    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.75rem;">
      <a href="/admin/invoices" class="ghost-btn" style="justify-content: flex-start;">
        <i class="fa-solid fa-plus"></i> New Database Invoice
      </a>
      <a href="/admin/stores" class="ghost-btn" style="justify-content: flex-start;">
        <i class="fa-solid fa-store"></i> Add or Manage Stores
      </a>
      <a href="/admin/url_invoices" class="ghost-btn" style="justify-content: flex-start;">
        <i class="fa-solid fa-link"></i> Create Stateless URL Invoice
      </a>
    </div>
  </section>
</div>

<%- include('layout/footer') %>
