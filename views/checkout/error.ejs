<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow,noarchive">
    <title>Payment Unavailable - BTCPay Server Lite</title>
    <link rel="stylesheet" href="/assets/checkout.css">
</head>
<body>
<main class="checkout-shell">
    <section class="checkout-card error-card" aria-labelledby="error-title">
        <span class="error-code"><%= checkoutErrorStatus || 404 %></span>
        <span class="error-symbol" aria-hidden="true">!</span>
        <p class="eyebrow">Bitcoin Checkout</p>
        <h1 id="error-title">Payment Unavailable</h1>
        <p class="error-message"><%= checkoutErrorMessage || 'The invoice was not found, has expired, or the signature is invalid.' %></p>
        <a class="secondary-button" href="/">
            Back to Home
        </a>
    </section>
</main>
</body>
</html>
