<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <title>Installation – BTCPay Server Lite</title>
  <link rel="stylesheet" href="/assets/install.css">
</head>
<body>
  <main class="installer-shell">
    <header class="installer-hero">
      <div class="brand-mark" aria-hidden="true">₿</div>
      <div>
        <span class="eyebrow">BTCPay Server Lite</span>
        <h1>System Installation</h1>
        <p>Database schema, cryptographic configuration, and primary administrator in one step.</p>
      </div>
    </header>

    <% if (installed && !reinstall) { %>
      <section class="installer-card success-card" style="border-color: rgba(50, 213, 131, 0.35);">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
          <span style="display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: rgba(50, 213, 131, 0.15); color: #32d583; font-size: 1.5rem; font-weight: bold;">✓</span>
          <div>
            <h2 style="margin: 0; font-size: 1.35rem; color: #fff;">System is Installed and Operational</h2>
            <p style="margin: 0.25rem 0 0; color: #9aa3b5; font-size: 0.9rem;">
              Database is configured and administrator account <strong><%= adminEmail %></strong> is active.
            </p>
          </div>
        </div>
        <p style="color: #c3cad8; font-size: 0.92rem; line-height: 1.5;">
          The system installer is locked by the active configuration. You can proceed directly to the administrative dashboard or log in.
        </p>
        <div style="display: flex; gap: 12px; margin-top: 1.5rem; flex-wrap: wrap;">
          <a class="primary-button" href="/login" style="display: inline-block; padding: 12px 24px; border-radius: 12px; background: linear-gradient(145deg, #a855f7, #7e22ce); color: #fff; text-decoration: none; font-weight: 700; font-size: 0.95rem;">
            Go to Sign In
          </a>
          <a class="secondary-button" href="/admin" style="display: inline-block; padding: 12px 24px; border-radius: 12px; background: rgba(255, 255, 255, 0.08); color: #f5f7fb; text-decoration: none; font-weight: 600; font-size: 0.95rem; border: 1px solid #282d39;">
            Open Admin Dashboard
          </a>
          <a class="secondary-button" href="/download-zip" download="btcpayserverlitevs2.zip" style="display: inline-block; padding: 12px 24px; border-radius: 12px; background: rgba(168, 85, 247, 0.12); color: #c084fc; text-decoration: none; font-weight: 600; font-size: 0.95rem; border: 1px solid rgba(168, 85, 247, 0.3);">
            Download ZIP
          </a>
          <a href="/install?reinstall=1" style="display: inline-block; padding: 12px 20px; color: #9aa3b5; text-decoration: none; font-size: 0.88rem; align-self: center;">
            Reconfigure installation…
          </a>
        </div>
      </section>
    <% } else { %>

      <section class="installer-card requirements-card" aria-labelledby="requirements-title">
        <div class="section-heading">
          <div>
            <span class="step">Check</span>
            <h2 id="requirements-title">Server & System Requirements</h2>
          </div>
          <span class="status-pill status-ok">Ready</span>
        </div>
        <div class="requirements-grid">
          <% requirements.forEach(function(req) { %>
            <div class="requirement <%= req.ok ? 'requirement-ok' : 'requirement-error' %>">
              <span class="requirement-icon" aria-hidden="true"><%= req.ok ? '✓' : '!' %></span>
              <div>
                <strong><%= req.name %></strong>
                <span title="<%= req.detail %>"><%= req.detail %></span>
              </div>
            </div>
          <% }); %>
        </div>
      </section>

      <% if (error) { %>
        <div class="alert" role="alert">
          <strong>Installation could not be completed:</strong>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="post" action="/install" class="installer-form" autocomplete="off">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

        <section class="installer-card">
          <div class="section-heading">
            <div>
              <span class="step">Step 1</span>
              <h2>Database Connection</h2>
              <p>Connect to a dedicated MariaDB / MySQL or SQLite compatible store.</p>
            </div>
          </div>
          <div class="field-grid four-columns">
            <label class="field field-wide">
              <span>Database Host</span>
              <input name="db_host" value="<%= posted.db_host || '127.0.0.1' %>" maxlength="253" required>
            </label>
            <label class="field">
              <span>Port</span>
              <input name="db_port" type="number" min="1" max="65535" value="<%= posted.db_port || '3306' %>" required>
            </label>
            <label class="field">
              <span>Database Name</span>
              <input name="db_name" value="<%= posted.db_name || 'btcpay_lite' %>" maxlength="64" required>
            </label>
            <label class="field">
              <span>Database User</span>
              <input name="db_user" value="<%= posted.db_user || 'btcpay_app' %>" maxlength="128" required>
            </label>
            <label class="field field-wide">
              <span>Database Password</span>
              <input name="db_pass" type="password" placeholder="••••••••••••" autocomplete="new-password">
            </label>
          </div>
          <label class="check-field">
            <input type="checkbox" name="create_database" value="1" checked>
            <span>
              <strong>Create database and tables automatically</strong>
              <small>Applies schema from <code>sql.sql</code>. Idempotent and safe for fresh setups.</small>
            </span>
          </label>
        </section>

        <section class="installer-card">
          <div class="section-heading">
            <div>
              <span class="step">Step 2</span>
              <h2>Administrator & Public URL</h2>
              <p>Credentials used for the primary system administrator account.</p>
            </div>
          </div>
          <div class="field-grid two-columns">
            <label class="field">
              <span>Administrator Email</span>
              <input name="admin_email" type="email" value="<%= posted.admin_email || 'admin@btcpayserver.local' %>" maxlength="254" required>
            </label>
            <label class="field">
              <span>Public Application URL</span>
              <input name="app_url" type="url" value="<%= posted.app_url || appUrl %>" placeholder="https://pay.example.com" required>
            </label>
            <label class="field">
              <span>Administrator Password</span>
              <input name="admin_password" type="password" minlength="12" maxlength="72" value="<%= posted.admin_password || '' %>" placeholder="At least 12 characters" autocomplete="new-password" required>
              <small>12 to 72 characters. Stored with strong password hashing.</small>
            </label>
            <label class="field">
              <span>Confirm Password</span>
              <input name="admin_password_confirm" type="password" minlength="12" maxlength="72" value="<%= posted.admin_password_confirm || '' %>" placeholder="Repeat password" autocomplete="new-password" required>
            </label>
          </div>
        </section>

        <section class="installer-card">
          <details>
            <summary>
              <span>
                <span class="step">Step 3</span>
                <strong>Electrum Daemon & Wallet Paths</strong>
                <small>Bitcoin node and Electrum RPC parameters.</small>
              </span>
              <span class="summary-arrow" aria-hidden="true">⌄</span>
            </summary>
            <div class="details-content" style="margin-top: 1.25rem;">
              <div class="field-grid four-columns">
                <label class="field field-wide">
                  <span>Electrum RPC Host</span>
                  <input name="rpc_host" value="<%= posted.rpc_host || '127.0.0.1' %>" required>
                </label>
                <label class="field">
                  <span>RPC Port</span>
                  <input name="rpc_port" type="number" min="1" max="65535" value="<%= posted.rpc_port || '7777' %>" required>
                </label>
                <label class="field">
                  <span>RPC User</span>
                  <input name="rpc_user" value="<%= posted.rpc_user || 'electrum' %>">
                </label>
                <label class="field">
                  <span>RPC Password</span>
                  <input name="rpc_pass" type="password" placeholder="••••••••" autocomplete="new-password">
                </label>
                <label class="field field-full">
                  <span>Master Wallet Path</span>
                  <input name="wallet_path" value="<%= posted.wallet_path || '/opt/btcpay_wallets/admin_wallet' %>" required>
                </label>
                <label class="field field-full">
                  <span>Store Wallets Directory</span>
                  <input name="store_wallets_dir" value="<%= posted.store_wallets_dir || '/opt/btcpay_wallets' %>" required>
                </label>
              </div>
            </div>
          </details>
        </section>

        <section class="submit-card" style="display: flex; align-items: center; justify-content: space-between; padding: 20px 28px; border: 1px solid var(--line); border-radius: 18px; background: rgba(17, 19, 26, 0.95); margin-top: 1.5rem;">
          <div>
            <strong style="display: block; font-size: 1rem; color: #fff;">Ready to initialize</strong>
            <span style="color: var(--muted); font-size: 0.85rem;">Cryptographic API keys, webhook secrets, and database tables will be provisioned.</span>
          </div>
          <button type="submit" class="primary-button" style="padding: 14px 28px; border: none; border-radius: 12px; background: linear-gradient(145deg, #a855f7, #7e22ce); color: #fff; font-weight: 700; font-size: 0.95rem; cursor: pointer; box-shadow: 0 8px 25px rgba(168, 85, 247, 0.35);">
            Complete Installation
          </button>
        </section>
      </form>
    <% } %>
  </main>
</body>
</html>
