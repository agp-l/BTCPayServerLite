            <section id="invoices" class="doc-section">
                <p class="eyebrow">04 — Invoices</p>
                <h2>Creating & Fetching Invoices</h2>
                <div class="endpoint">
                    <div class="endpoint-title"><span class="method post">POST</span><span
                            class="endpoint-path">/stores/{storeId}/invoices</span></div>
                    <p>Creates a new Bitcoin invoice and generates a receiving address derived from your BIP84 XPUB or wallet daemon.</p>
                    <dl class="param-list">
                        <div class="param">
                            <dt>amount <span class="required">required</span></dt>
                            <dd>Decimal string. e.g. <code class="inline">"1990.00"</code> or <code class="inline">"0.001"</code>.</dd>
                        </div>
                        <div class="param">
                            <dt>currency</dt>
                            <dd><code class="inline">BTC</code>, <code class="inline">SAT</code>/<code
                                    class="inline">SATS</code> or fiat currency supported by the exchange rate provider. Default is BTC.</dd>
                        </div>
                        <div class="param">
                            <dt>metadata</dt>
                            <dd>Optional JSON object with order ID and custom application metadata.</dd>
                        </div>
                        <div class="param">
                            <dt>checkout.expirationMinutes</dt>
                            <dd>Validity 1 to 43,200 minutes. Default is 15 minutes.</dd>
                        </div>
                        <div class="param">
                            <dt>checkout.redirectURL</dt>
                            <dd>Optional HTTP/HTTPS redirect address for customer return.</dd>
                        </div>
                        <div class="param">
                            <dt>checkout.redirectAutomatically</dt>
                            <dd>Boolean. Automatically redirect upon settlement.</dd>
                        </div>
                    </dl>
                </div>
                <div class="endpoint">
                    <div class="endpoint-title"><span class="method">GET</span><span
                            class="endpoint-path">/stores/{storeId}/invoices/{invoiceId}</span></div>
                    <p>Returns current status and invoice metadata. Invoices can only be fetched using the API key of their owning store.</p>
                    <div class="code-block">
                        <div class="code-head"><span>shell</span><button class="copy-button"
                                type="button">Copy</button></div>
                        <pre><code>curl "<%= apiBaseUrl %>/stores/STORE_ID/invoices/INVOICE_ID" \
  -H "Authorization: token STORE_API_KEY"</code></pre>
                    </div>
                </div>
                <div class="endpoint">
                    <div class="endpoint-title"><span class="method">GET</span><span
                            class="endpoint-path">/stores/{storeId}/invoices/{invoiceId}/payment-methods</span></div>
                    <p>Returns the BTC address in <code class="inline">destination</code>, BIP21 URI in <code
                            class="inline">paymentLink</code>, expected total, and remaining <code
                            class="inline">due</code> amount.</p>
                </div>

                <h3>Standalone PHP Client (No Dependencies)</h3>
                <div class="code-block">
                    <div class="code-head"><span>PHP 8+</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>&lt;?php
$apiBase = '<%= apiBaseUrl %>';
$storeId = getenv('BTCPAY_STORE_ID');
$apiKey = getenv('BTCPAY_STORE_API_KEY');

$payload = [
    'amount' =&gt; '1490.00',
    'currency' =&gt; 'CZK',
    'metadata' =&gt; ['orderId' =&gt; 'OBJ-2026-085'],
    'checkout' =&gt; ['expirationMinutes' =&gt; 20],
];

$curl = curl_init($apiBase . '/stores/' . rawurlencode($storeId) . '/invoices');
curl_setopt_array($curl, [
    CURLOPT_POST =&gt; true,
    CURLOPT_RETURNTRANSFER =&gt; true,
    CURLOPT_TIMEOUT =&gt; 15,
    CURLOPT_HTTPHEADER =&gt; [
        'Authorization: token ' . $apiKey,
        'Content-Type: application/json',
        'Accept: application/json',
    ],
    CURLOPT_POSTFIELDS =&gt; json_encode($payload, JSON_THROW_ON_ERROR),
]);

$raw = curl_exec($curl);
$status = curl_getinfo($curl, CURLINFO_RESPONSE_CODE);
if ($raw === false || $status &lt; 200 || $status &gt;= 300) {
    throw new RuntimeException('BTCPay API request failed: HTTP ' . $status);
}
$invoice = json_decode($raw, true, 32, JSON_THROW_ON_ERROR);
header('Location: ' . $invoice['checkoutLink'], true, 303);</code></pre>
                </div>
            </section>

            <section id="statuses" class="doc-section">
                <p class="eyebrow">05 — Invoice Lifecycle</p>
                <h2>Stavy faktury</h2>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Stav</th>
                                <th>Meaning</th>
                                <th>Action for Merchant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="status s-new">New</span></td>
                                <td>Invoice is awaiting payment.</td>
                                <td>Keep order in unpaid/pending state.</td>
                            </tr>
                            <tr>
                                <td><span class="status s-processing">Processing</span></td>
                                <td>Payment detected in mempool, awaiting confirmation.</td>
                                <td>Display "payment confirming"; do not ship order yet.</td>
                            </tr>
                            <tr>
                                <td><span class="status s-settled">Settled</span></td>
                                <td>Expected payment is fully confirmed on-chain.</td>
                                <td>Mark order as paid. Implement idempotently.</td>
                            </tr>
                            <tr>
                                <td><span class="status s-expired">Expired</span></td>
                                <td>Invoice expired without full payment.</td>
                                <td>Allow customer to create a new invoice.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p>Never rely solely on browser redirects. Authoritatively settle orders via the <code class="inline">InvoiceSettled</code> webhook, then optionally verify status via GET request.</p>
            </section>

            <section id="webhooks" class="doc-section">
                <p class="eyebrow">06 — Asynchronous Webhooks</p>
                <h2>Webhooky</h2>
                <p class="section-intro">Webhooks notify your server of invoice state changes. Events are queued persistently and retried automatically on failure.</p>
                <div class="endpoint">
                    <div class="endpoint-title"><span class="method post">POST</span><span
                            class="endpoint-path">/stores/{storeId}/webhooks</span></div>
                    <div class="code-block">
                        <div class="code-head"><span>shell</span><button class="copy-button"
                                type="button">Copy</button></div>
                        <pre><code>curl -X POST "<%= apiBaseUrl %>/stores/STORE_ID/webhooks" \
  -H "Authorization: token STORE_API_KEY" \
  -H "Content-Type: application/json" \
  --data '{
    "url": "https://shop.example.cz/webhooks/btcpay",
    "secret": "nahodny-tajny-retezec-minimalne-16-znaku"
  }'</code></pre>
                    </div>
                    <p>If no <code class="inline">secret</code> is provided, the server generates one. Save the secret returned upon registration; it will not be displayed again.</p>
                </div>
                <h3>Webhook Payload</h3>
                <div class="code-block">
                    <div class="code-head"><span>application/json</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>{
  "deliveryId": "wd_f03370d1c0214629a4bf4f716bafc681",
  "webhookId": "wh_51c76e40c9d2",
  "storeId": "STORE_ID",
  "invoiceId": "inv_8e9a31f7c20b",
  "type": "InvoiceSettled",
  "timestamp": 1788277308
}</code></pre>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Trigger Condition</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>InvoiceProcessing</code></td>
                                <td>Payment detected in mempool, awaiting confirmation.</td>
                            </tr>
                            <tr>
                                <td><code>InvoiceSettled</code></td>
                                <td>Payment is confirmed on-chain and amount is satisfied.</td>
                            </tr>
                            <tr>
                                <td><code>InvoiceExpired</code></td>
                                <td>Invoice expired without full payment.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <h3>Verifying Signatures in PHP</h3>
                <p>The signature is in header <code class="inline">BTCPay-Sig: sha256=…</code>. Compute HMAC over the exact raw HTTP request body bytes, never re-encoded JSON.</p>
                <div class="code-block">
                    <div class="code-head"><span>PHP 8+</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>&lt;?php
$secret = getenv('BTCPAY_WEBHOOK_SECRET');
$rawBody = file_get_contents('php://input');
$received = $_SERVER['HTTP_BTCPAY_SIG'] ?? '';
$expected = 'sha256=' . hash_hmac('sha256', $rawBody, $secret);

if (!hash_equals($expected, $received)) {
    http_response_code(401);
    exit;
}

$event = json_decode($rawBody, true, 32, JSON_THROW_ON_ERROR);

// Store deliveryId or invoiceId + type as idempotency key.
if ($event['type'] === 'InvoiceSettled') {
    markOrderAsPaidOnce($event['invoiceId']);
}

http_response_code(204);</code></pre>
                </div>
                <ul class="check-list">
                    <li>Return HTTP 2xx promptly; offload long-running tasks to background queues.</li>
                    <li>Ensure event handling is safe to execute multiple times (idempotent).</li>
                    <li>Always verify HMAC signature before modifying order status.</li>
                    <li>Webhook URL must be a public HTTPS address; private IP ranges are blocked in production.</li>
                </ul>
            </section>

            <section id="stateless" class="doc-section">
                <p class="eyebrow">07 — Stateless Mode</p>
                <h2>Stateless faktury</h2>
                <p class="section-intro">The Stateless API creates signed payment links without database storage. Ideal for lightweight links and static environments; does not support webhooks.</p>
                <div class="endpoint">
                    <div class="endpoint-title"><span class="method post">POST</span><span
                            class="endpoint-path"><%= statelessUrl %></span></div>
                </div>
                <div class="code-block">
                    <div class="code-head"><span>shell</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>curl -X POST "<%= statelessUrl %>" \
  -H "Authorization: Bearer STATELESS_API_KEY" \
  -H "Content-Type: application/json" \
  --data '{
    "amount": "0.00100000",
    "description": "Order OBJ-2026-086",
    "order_id": "OBJ-2026-086",
    "expiration_minutes": 60
  }'</code></pre>
                </div>
                <div class="code-block">
                    <div class="code-head"><span>200 · application/json</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>{
  "status": "success",
  "data": {
    "token": "SIGNED_TOKEN",
    "bip21_uri": "bitcoin:bc1q...?amount=0.00100000",
    "amount": "0.00100000",
    "description": "Order OBJ-2026-086",
    "order_id": "OBJ-2026-086",
    "wallet": "merchant_wallet",
    "created_at": 1788277200,
    "expires_at": 1788280800,
    "expires_in_minutes": 60,
    "url": "<%= baseUrl %>/url-invoice?token=SIGNED_TOKEN"
  }
}</code></pre>
                </div>
                <dl class="param-list">
                    <div class="param">
                        <dt>amount <span class="required">required</span></dt>
                        <dd>Positive BTC amount with up to 8 decimal places.</dd>
                    </div>
                    <div class="param">
                        <dt>description <span class="required">required</span></dt>
                        <dd>Description up to 255 bytes.</dd>
                    </div>
                    <div class="param">
                        <dt>order_id</dt>
                        <dd>Optional order identifier up to 255 bytes.</dd>
                    </div>
                    <div class="param">
                        <dt>expiration_minutes</dt>
                        <dd>10 to 43,200 minutes; out-of-range values are clamped. Default is 15.</dd>
                    </div>
                </dl>
            </section>

            <section id="rates" class="doc-section">
                <p class="eyebrow">08 — Exchange Rates</p>
                <h2>Exchange Rate Quote</h2>
                <p>Returns gross BTC amount, fee, and net payout based on the configured market rate provider.</p>
                <div class="code-block">
                    <div class="code-head"><span>shell</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>curl -X POST "<%= apiBaseUrl %>/stores/STORE_ID/exchange/quotes" \
  -H "Authorization: token STORE_API_KEY" \
  -H "Content-Type: application/json" \
  --data '{"amount":"500.00","currency":"CZK"}'</code></pre>
                </div>
                <div class="note info"><span class="note-icon" aria-hidden="true">i</span>
                    <div><strong>Spot Calculation, Not a Locked Rate</strong>
                        <p>Quotes provide real-time calculation. Fiat currency availability depends on the configured rate provider.</p>
                    </div>
                </div>
            </section>

            <section id="payouts" class="doc-section">
                <p class="eyebrow">09 — Optional Module</p>
                <h2>Outgoing BTC Payouts</h2>
                <div class="note danger"><span class="note-icon" aria-hidden="true">!</span>
                    <div><strong>Payouts Transfer Real Bitcoin</strong>
                        <p>This module is disabled by default. Enable only after wallet backup, dedicated key configuration, and testing on testnet/regtest.</p>
                    </div>
                </div>
                <h3>Secure Two-Step Workflow</h3>
                <div class="code-block">
                    <div class="code-head"><span>shell</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>curl -X POST "<%= apiBaseUrl %>/stores/STORE_ID/payouts" \
  -H "Authorization: token PAYOUT_API_KEY" \
  -H "Idempotency-Key: exchange-order-2026-000001" \
  -H "Content-Type: application/json" \
  --data '{
    "destination": "bc1q...",
    "amount": "500.00",
    "currency": "CZK",
    "payoutMethodId": "BTC-CHAIN",
    "approved": false,
    "metadata": {"orderId":"EX-2026-000001"}
  }'</code></pre>
                </div>
                <p>Response enters status <code class="inline">AwaitingApproval</code> with <code class="inline">id</code> and <code class="inline">revision</code>. After independent destination and amount verification, approve the payout:</p>
                <div class="code-block">
                    <div class="code-head"><span>shell</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>curl -X POST "<%= apiBaseUrl %>/payouts/PAYOUT_ID" \
  -H "Authorization: token PAYOUT_API_KEY" \
  -H "Content-Type: application/json" \
  --data '{"revision":0}'</code></pre>
                </div>
                <ul class="check-list">
                    <li>Every new financial operation must include a unique <code class="inline">Idempotency-Key</code> (16–128 characters).</li>
                    <li>On network failure or timeout, retry the exact same request with the identical key.</li>
                    <li>Status <code class="inline">InProgress</code> confirms transaction broadcast, not on-chain confirmation.</li>
                    <li>Only use <code class="inline">approved: true</code> in strictly audited, limit-bounded automation.</li>
                </ul>
            </section>

            <section id="errors" class="doc-section">
                <p class="eyebrow">10 — Resilient Integration</p>
                <h2>Errors & Retry Strategy</h2>
                <p>Greenfield API returns errors in format <code class="inline">{"message":"…"}</code>. The Stateless API returns <code class="inline">{"status":"error","message":"…"}</code>.</p>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>HTTP</th>
                                <th>Meaning</th>
                                <th>Recommended Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>400</code></td>
                                <td>Invalid JSON, amount, currency, or parameter.</td>
                                <td>Do not retry without fixing the input.</td>
                            </tr>
                            <tr>
                                <td><code>401</code></td>
                                <td>Missing or invalid API key.</td>
                                <td>Check Authorization header and required key scope.</td>
                            </tr>
                            <tr>
                                <td><code>404</code></td>
                                <td>Endpoint, store, invoice, or payout not found.</td>
                                <td>Verify resource ID and store scoping.</td>
                            </tr>
                            <tr>
                                <td><code>405</code></td>
                                <td>HTTP method not allowed.</td>
                                <td>Use documented HTTP method.</td>
                            </tr>
                            <tr>
                                <td><code>409</code></td>
                                <td>Konflikt stavu, limitu nebo idempotence.</td>
                                <td>Fetch current resource state; avoid duplicate operations.</td>
                            </tr>
                            <tr>
                                <td><code>413</code></td>
                                <td>Payload or metadata exceeds size limits.</td>
                                <td>Reduce payload size; default maximum body size is 65,536 bytes.</td>
                            </tr>
                            <tr>
                                <td><code>500</code></td>
                                <td>Internal server error.</td>
                                <td>Log request ID and retry with exponential backoff.</td>
                            </tr>
                            <tr>
                                <td><code>503</code></td>
                                <td>Server busy, rate provider or Electrum daemon unavailable.</td>
                                <td>Respect <code>Retry-After</code> and apply exponential backoff.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="code-block">
                    <div class="code-head"><span>JSON error</span><button class="copy-button"
                            type="button">Copy</button></div>
                    <pre><code>{"message":"Invalid API key or store."}</code></pre>
                </div>
            </section>

            <section id="security" class="doc-section">
                <p class="eyebrow">11 — Production Checklist</p>
                <h2>Integration Security</h2>
                <ul class="check-list">
                    <li>Dispatch all API requests from your backend server over HTTPS.</li>
                    <li>Store API keys in environment variables or a secret manager, never in source code.</li>
                    <li>Do not share Store, Payout, or Stateless keys and rotate them regularly.</li>
                    <li>Verify webhook signatures using constant-time comparison (<code class="inline">hash_equals</code>) over raw HTTP body bytes.</li>
                    <li>Implement order settlement logic idempotently.</li>
                    <li>Run a full end-to-end smoke test including webhook receipt and test transaction before production.</li>
                    <li>Never expose Electrum RPC ports, wallet files, seeds, or private keys to the public internet.</li>
                    <li>Only enable the Payout API with low thresholds and a dedicated key.</li>
                </ul>
